<Project Sdk="Microsoft.NET.Sdk">
  <!-- Metrics layer tests with synthetic data (the contract adapter is compiled with the Dashboards add-on). -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <LangVersion>7.3</LangVersion>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <RootNamespace>Vulnerator.Metrics.Tests</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\..\Metrics\*.cs" Link="Metrics\%(Filename)%(Extension)" />
    <Reference Include="System.Runtime.Serialization" />
  </ItemGroup>
</Project>
